{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordprotocol.org/schemas/evc-graph-0.1.schema.json",
  "title": "CORD EVC Graph 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "subject", "current_state", "claims", "evidence", "dependencies"],
  "properties": {
    "schema_version": {"const": "cord-evc-0.1"},
    "graph_id": {"$ref": "#/$defs/id"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "current_state": {"type": "array", "items": {"$ref": "#/$defs/state"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^(?!\\s)(?:.*\\S)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependencyType": {"enum": ["SUBJECT_VERSION", "MODEL_VERSION", "CONFIGURATION", "TOOL_PERMISSION", "DATASET", "TEST_PROFILE", "VERIFIER_BUILD", "TRUST_ANCHOR", "SIGNING_KEY", "TIMESTAMP_POLICY", "EVIDENCE_ARTIFACT", "REGULATORY_PROFILE"]},
    "state": {
      "type": "object", "additionalProperties": false, "required": ["type", "object_id", "sha256"],
      "properties": {"type": {"$ref": "#/$defs/dependencyType"}, "object_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "scope", "evidence_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "statement": {"$ref": "#/$defs/id"}, "scope": {"$ref": "#/$defs/id"}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "dependency": {
      "type": "object", "additionalProperties": false, "required": ["claim_id", "type", "object_id", "expected_sha256"],
      "properties": {"claim_id": {"$ref": "#/$defs/id"}, "type": {"$ref": "#/$defs/dependencyType"}, "object_id": {"$ref": "#/$defs/id"}, "expected_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}