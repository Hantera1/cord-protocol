{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cord-protocol.org/spec/license-certificate-public-0.1.schema.json",
  "title": "Cord Public License Certificate 0.1",
  "description": "Minimal public certificate for checking license status. Excludes personal data, price, invoice and contract content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "license_id",
    "product_sku",
    "product_version",
    "licensor_name",
    "territory",
    "status",
    "valid_from",
    "valid_until",
    "issuer_key_id",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "license_id": {
      "type": "string",
      "pattern": "^CORD-[A-Z0-9]{2,8}-[0-9]{4}-[A-Z0-9]{6}$"
    },
    "product_sku": {
      "enum": [
        "CORD-TRADE-STARTER",
        "CORD-TRADE-BUSINESS",
        "CORD-TRADE-GROUP",
        "CORD-TRADE-RESELLER",
        "CORD-TRADE-WHITE-LABEL"
      ]
    },
    "product_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "licensor_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "territory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64
      }
    },
    "status": {
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "SUSPENDED",
        "TERMINATED",
        "REVOKED"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "issuer_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
