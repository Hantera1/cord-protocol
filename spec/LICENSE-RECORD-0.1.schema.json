{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cord-protocol.org/spec/license-record-0.1.schema.json",
  "title": "Cord Commercial License Record 0.1",
  "description": "Private registry record for commercial license administration. Not a public credential and not a substitute for a signed contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "license_id",
    "licensor",
    "licensee",
    "product",
    "territory",
    "status",
    "valid_from",
    "valid_until",
    "entitlements",
    "agreement_hash",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "license_id": {
      "type": "string",
      "pattern": "^CORD-[A-Z0-9]{2,8}-[0-9]{4}-[A-Z0-9]{6}$"
    },
    "licensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_name",
        "jurisdiction"
      ],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 2
        },
        "registration_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "licensee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_name",
        "jurisdiction"
      ],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 2
        },
        "registration_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "version",
        "license_type"
      ],
      "properties": {
        "sku": {
          "enum": [
            "CORD-TRADE-BUSINESS",
            "CORD-TRADE-GROUP",
            "CORD-TRADE-RESELLER",
            "CORD-TRADE-MASTER-DISTRIBUTOR",
            "CORD-TRADE-WHITE-LABEL"
          ]
        },
        "version": {
          "type": "string"
        },
        "license_type": {
          "enum": [
            "business",
            "group",
            "reseller",
            "master_distribution",
            "white_label"
          ]
        }
      }
    },
    "territory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "PENDING_PAYMENT",
        "ACTIVE",
        "SUSPENDED",
        "EXPIRED",
        "TERMINATED",
        "REVOKED"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "entitlements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legal_entities": {
          "type": "integer",
          "minimum": 1
        },
        "users": {
          "type": "integer",
          "minimum": 1
        },
        "annual_agreements": {
          "type": "integer",
          "minimum": 0
        },
        "sublicensing": {
          "type": "boolean"
        },
        "resale_authorized": {
          "type": "boolean"
        },
        "white_label_authorized": {
          "type": "boolean"
        }
      }
    },
    "agreement_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "partner_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer_key_id": {
      "type": "string",
      "minLength": 1
    },
    "certificate_signature": {
      "type": "string",
      "minLength": 1
    }
  }
}
